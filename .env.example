# Voice: Microsoft Edge TTS — free, NO API key required (pip: edge-tts).

# Stock video providers (either or both; the engine uses what it finds)
# https://pixabay.com/accounts/settings/  -> API key (Videos API)
PIXABAY_API_KEY=
# https://www.pexels.com/api/             -> API Key
PEXELS_API_KEY=

# Working directory for the (multi-GB) scratch space. MUST NOT be inside OneDrive.
# Default: C:\videoengine_work
VIDEOENGINE_WORK=C:\videoengine_work
